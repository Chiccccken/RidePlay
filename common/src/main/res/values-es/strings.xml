    <string name="settings_mfi_target_description">Elige USB/CH341 solo si hay un adaptador de autenticación CH341 conectado a la unidad principal. Sin él, elige Local sin conexión. Se aplica en la próxima conexión.</string>
    <string name="settings_call_speakerphone">Llamadas por el altavoz</string>
    <string name="settings_call_speakerphone_description">Para un teléfono o una tableta Android usados como unidad principal: reproduce las llamadas de CarPlay por su altavoz en lugar del auricular y usa su micrófono manos libres. Déjalo desactivado en la unidad principal de un coche. Se aplica desde la próxima llamada.</string>
    <string name="settings_navigation_attenuation">Volumen de las indicaciones de navegación</string>
    <string name="settings_navigation_attenuation_value">%1$d dB</string>
    <string name="settings_navigation_attenuation_description">Reduce solo las indicaciones de navegación de CarPlay, sin cambiar música ni llamadas. Se aplica al instante; sigue funcionando el volumen de navegación de la unidad.</string>
    <string name="settings_car_hotspot_control">Punto de acceso del coche</string>
    <string name="settings_auto_car_hotspot_system_description">Activa el punto de acceso guardado del coche al abrir DiPlay y antes de una conexión inalámbrica. DiPlay necesita el acceso de Android «Modificar ajustes del sistema»; no se requiere ADB. Para tener el punto de acceso tras un reinicio completo, activa también abrir DiPlay al arrancar el coche. El punto de acceso no se desactiva automáticamente.</string>
    <string name="settings_write_settings_granted">Acceso «Modificar ajustes del sistema»: permitido</string>
    <string name="settings_write_settings_missing">El acceso «Modificar ajustes del sistema» aún no está permitido. Permítelo para que DiPlay pueda activar el punto de acceso.</string>
    <string name="settings_write_settings_allow">Permitir acceso</string>
    <string name="settings_wifi_direct_scan_pause">Pausar la búsqueda de Wi-Fi del coche con CarPlay · requiere ADB</string>
    <string name="settings_wifi_direct_scan_pause_description">Con Wi-Fi Direct el coche busca redes Wi-Fi cada pocos segundos, y cada búsqueda hace que la música y el vídeo se corten. Con esta opción, DiPlay pausa la búsqueda mientras CarPlay está activo. Entonces el coche tampoco se conecta solo a una red conocida, como el punto de acceso de tu teléfono, hasta que CarPlay termina; puedes conectarte a mano en los ajustes de Wi-Fi del coche. Desactívala para que el coche se conecte solo. Se aplica en la próxima conexión.</string>
    <string name="temporary_system_bars">Mostrar barras del sistema durante 5 segundos</string>
    <string name="temporary_system_bars_description">Opcional: desliza hacia arriba con el número de dedos configurado para abrir los ajustes de DiPlay y mostrar durante cinco segundos las barras ocultas del vehículo. Deslizar hacia abajo sigue abriendo los ajustes. Desactívalo si hay conflictos; algunos equipos pueden ignorarlo.</string>
    <string name="wheel_media_play_pause">Tecla reproducir/pausar del volante</string>
    <string name="wheel_media_play_pause_description">Asigna una tecla disponible del volante o teclado para alternar reproducción y pausa en CarPlay. Funciona con CarPlay conectado, también en segundo plano con el servicio de teclas activo. Durante llamadas o sin conexión, conserva su función original. El vehículo puede reservar ciertas teclas.</string>
    <string name="wheel_key_role_media_play_pause">Reproducir/pausar</string>
    <string name="wheel_media_navigation_reserved">Las teclas de navegación, Inicio, volumen, asistente de voz y multimedia conservan sus funciones originales. Elige otra tecla.</string>
    <string name="black_corner_overlay">Esquinas redondeadas negras</string>
    <string name="black_corner_overlay_description">Cubre de negro las esquinas de CarPlay. Elige Desactivado, un radio manual o la máscara del iPhone (experimental). El modo iPhone necesita reconexión y vuelve a 24 dp si no llega una máscara válida. Los cambios manuales se previsualizan al instante; guarda para conservarlos.</string>
    <string name="black_corner_overlay_off">Desactivado</string>
    <string name="black_corner_overlay_value">%1$d dp</string>
    <string name="iphone_corner_mask_mode">Máscara del iPhone (experimental)</string>
    <string name="settings_launcher_bubble">Burbuja de la pantalla de inicio (experimental)</string>
    <string name="settings_launcher_bubble_description">Muestra el icono de DiPlay como una burbuja sobre la pantalla de inicio del coche: tócala para volver a CarPlay y arrástrala donde quieras. Se oculta al abrir DiPlay y vuelve al salir. Mantén pulsado para fijar su posición y vuelve a mantener pulsado para liberarla. Necesita el permiso para mostrarse sobre otras aplicaciones.</string>
    <string name="settings_launcher_bubble_size">Tamaño de la burbuja</string>
    <string name="settings_launcher_bubble_locked">Posición fijada</string>
    <string name="settings_launcher_bubble_unlocked">Posición liberada</string>
    <string name="settings_launcher_bubble_hold_to_lock">Mantén para fijar</string>
    <string name="settings_launcher_bubble_hold_to_unlock">Mantén para liberar</string>

    <string name="settings_hotspot_interface">Interfaz del punto de acceso (opcional)</string>
    <string name="settings_hotspot_interface_description">Solo para unidades que ejecutan su punto de acceso en una interfaz de red que Android no informa como punto de acceso Wi-Fi, por ejemplo eth0.3 en algunas unidades Geely, Lynk &amp; Co y otros Qualcomm. Déjalo vacío para encontrarla automáticamente.</string>
    <string name="settings_existing_wifi_interface">Interfaz de red (opcional)</string>
    <string name="settings_existing_wifi_interface_description">Solo para unidades cuya conexión LAN usa una interfaz que Android no informa como Wi-Fi, por ejemplo un adaptador USB en eth1. Déjalo vacío para elegirla automáticamente.</string>
    <string name="cluster_projection_shape">Forma del mapa del panel</string>
    <string name="cluster_projection_shape_half">Pantalla partida</string>
    <string name="cluster_projection_shape_full">Pantalla completa</string>
    <string name="cluster_projection_shape_description">La pantalla partida mantiene junto al mapa la velocidad y el estado que el panel muestra normalmente; la pantalla completa deja que el mapa ocupe todo el panel. DiPlay fija la forma cada vez que aparece el mapa de CarPlay, que de lo contrario anula la forma elegida en el coche. Requiere ADB por red en la unidad principal.</string>
    <string name="settings_cluster_speedometer_album_color">Usar el color del álbum en el fondo del velocímetro</string>
    <string name="settings_cluster_speedometer_album_color_description">Iguala el color del borde del álbum con transiciones suaves. Conserva la opacidad elegida.</string>
</resources>

    <string name="settings_wifi_direct_scan_pause">Pause the car\'s Wi-Fi search during CarPlay · needs ADB</string>
    <string name="settings_wifi_direct_scan_pause_description">Over Wi-Fi Direct the car searches for Wi-Fi networks every few seconds, and each search makes music and video stutter. With this on, DiPlay pauses the search while CarPlay runs. The car then also does not join a known network, such as your phone\'s hotspot, by itself until CarPlay ends; you can still join one in the car\'s Wi-Fi settings. Turn it off to let the car join automatically. Applies at the next connection.</string>
    <string name="temporary_system_bars">Temporary system bars (5 seconds)</string>
    <string name="temporary_system_bars_description">Optional: swipe up with the configured settings gesture fingers to show hidden car status/navigation bars for five seconds; swipe down still opens DiPlay settings. Disable on head units with conflicting gestures. Some firmware may ignore the request.</string>
    <string name="wheel_media_play_pause">Play/pause key on the wheel</string>
    <string name="wheel_media_play_pause_description">Assign any available steering-wheel or keyboard key to toggle CarPlay music playback. Works while CarPlay runs, including in the background if the wheel-key service is enabled. During calls or when disconnected, the vehicle keeps the key. A key reserved by firmware may not reach DiPlay.</string>
    <string name="wheel_key_role_media_play_pause">Play/pause</string>
    <string name="wheel_media_navigation_reserved">TV remote navigation, Home, volume, voice-assistant and media buttons keep their original functions. Choose a spare key.</string>
    <string name="black_corner_overlay">Black rounded corners</string>
    <string name="black_corner_overlay_description">Cover CarPlay picture corners in black. Choose Off, a manual radius, or the iPhone mask (experimental). The iPhone mode needs a new connection and falls back to 24 dp if no valid mask arrives. Manual changes preview immediately; Save preserves the selection.</string>
    <string name="black_corner_overlay_off">Off</string>
    <string name="black_corner_overlay_value">%1$d dp</string>
    <string name="iphone_corner_mask_mode">iPhone mask (experimental)</string>
    <string name="settings_launcher_bubble">Home-screen bubble (experimental)</string>
    <string name="settings_launcher_bubble_description">Shows the DiPlay icon as a bubble over the head unit\'s home screen: tap it to come back to CarPlay and drag it anywhere. It hides as soon as a DiPlay screen is open and comes back when you leave. Hold it to lock its place, hold it again to unlock. Needs \"display over other apps\".</string>
    <string name="settings_launcher_bubble_size">Bubble size</string>
    <string name="settings_launcher_bubble_locked">Place locked</string>
    <string name="settings_launcher_bubble_unlocked">Place unlocked</string>
    <string name="settings_launcher_bubble_hold_to_lock">Hold to lock</string>
    <string name="settings_launcher_bubble_hold_to_unlock">Hold to unlock</string>

    <string name="settings_hotspot_interface">Hotspot interface (optional)</string>
    <string name="settings_hotspot_interface_description">Only for head units that run their hotspot on a network interface Android does not report as a Wi-Fi hotspot, for example eth0.3 on some Geely, Lynk &amp; Co and other Qualcomm units. Leave empty to find it automatically.</string>
    <string name="settings_existing_wifi_interface">Network interface (optional)</string>
    <string name="settings_existing_wifi_interface_description">Only for units whose LAN connection runs on an interface Android does not report as Wi-Fi, for example a USB network card on eth1. Leave empty to pick it automatically.</string>
    <string name="cluster_projection_shape">Dashboard map shape</string>
    <string name="cluster_projection_shape_half">Half screen</string>
    <string name="cluster_projection_shape_full">Full screen</string>
    <string name="cluster_projection_shape_description">Half screen keeps the speed and status readouts the cluster normally shows beside the map; full screen lets the map fill the cluster. DiPlay sets the shape whenever the CarPlay map appears, which otherwise overrides the shape picked on the car. Needs ADB over network on the head unit.</string>
    <string name="settings_cluster_speedometer_album_color">Use album color for speedometer background</string>
    <string name="settings_cluster_speedometer_album_color_description">Match the album frame color with smooth transitions. Keeps the selected opacity.</string>
</resources>

    <string name="settings_carplay_same_task">在桌面卡片中保留 CarPlay（实验性）</string>
    <string name="settings_carplay_same_task_description">适用于在卡片或画中画窗口中显示 DiPlay 的桌面，例如迪友桌面卡片、嘟嘟桌面画中画。CarPlay 会像 0.2.11 及更早版本一样在 DiPlay 自己的窗口中打开，不再单独全屏打开。下次打开 CarPlay 时生效，不会断开连接。</string>
    <string name="settings_hotspot_name_non_english">热点名称含中文或其他非英文字符时，部分车机广播的名称 iPhone 找不到，CarPlay 会停在「正在准备 CarPlay…」。如出现这种情况，请把车机热点改为英文字母和数字的名称。</string>
    <string name="settings_speech_without_low_rates">USB 下更清晰的导航语音（实验性）</string>
    <string name="settings_speech_without_low_rates_description">USB 连接时，iPhone 可能以 8 kHz 电话音质发送导航播报和 Siri 的语音回答。开启后不再为这类声音提供 8 和 16 kHz，让 iPhone 选择更高的采样率。如果播报没有声音，请关闭。会重新连接 CarPlay。</string>
    <string name="settings_call_at_call_rate">通话使用其自身采样率（实验性）</string>
    <string name="settings_call_at_call_rate_description">以通话自身的采样率（8、16、24 或 32 kHz）的 PCM 提供通话音频，而不是 48 kHz 的 Opus，与原厂 CarPlay 接收器一致。下次连接时生效。如果通话没有声音，请关闭此项。</string>
    <string name="bluetooth_connections_not_real">此车机的系统蓝牙回报“已连接”，但实际上没有连到 iPhone：连一个不存在的服务也回报成功。这里的蓝牙由厂商自己的模块处理，应用无法使用，所以此车机无法使用无线 CarPlay。请尝试 USB 连接。</string>
    <string name="bluetooth_cannot_open_connections">此车机的系统蓝牙无法为应用建立连接：固件没有提供应用连接要用的那一部分。车机自己的蓝牙通话和音乐不受影响，但此车机无法使用无线 CarPlay。请尝试 USB 连接。</string>
    <string name="bluetooth_will_not_stay_on_hint">如果蓝牙在那里打不开，或打开后又自己关闭，说明这台车机的蓝牙只供它自己的通话和音乐使用，应用无法使用。这种情况下无法使用无线 CarPlay，请改用 USB 线。</string>
    <string name="settings_fce_cluster_guidance">FCE 仪表导航（实验性）</string>
    <string name="settings_fce_cluster_guidance_description">在 FCE 平台车机上，通过车机的车辆服务把 CarPlay 转向箭头和到下一路口的距离显示在仪表的导航界面。仅在一辆车上测试过；如果仪表显示异常，请关闭。</string>
    <string name="settings_cluster_music">仪表音乐（实验性）</string>
    <string name="settings_cluster_music_description">在仪表地图上显示方形专辑封面。可选择临时（8秒）或常驻封面；切歌时，歌曲名称和艺人始终在封面上显示8秒。位置和大小更改立即生效。需要仪表投屏及iPhone歌曲信息。</string>
    <string name="settings_cluster_music_mode">封面显示模式</string>
    <string name="settings_cluster_music_temporary">临时 · 8秒</string>
    <string name="settings_cluster_music_permanent">常驻</string>
    <string name="settings_cluster_music_horizontal">音乐卡片 · 水平位置</string>
    <string name="settings_cluster_music_vertical">音乐卡片 · 垂直位置</string>
    <string name="settings_cluster_music_size">音乐卡片 · 大小</string>
    <string name="settings_cluster_music_unknown">未知艺人</string>
    <string name="connection_help_reset_wifi">旧的 Wi-Fi Direct 连接可能阻止新连接。点击下方的“重置 CarPlay Wi-Fi”，然后重新连接。</string>
    <string name="connection_help_bluetooth_unusable">此车机的蓝牙无法向 iPhone 传输数据，因此无法使用无线 CarPlay。请使用支持数据传输的 USB 线。</string>
    <string name="connection_help_wifi_direct_beside_hotspot">请关闭车载热点后点“重新连接”；或在“连接设置”中选择“车载热点”，并保存热点名称和密码。</string>
    <string name="wifi_direct_refused_beside_hotspot">车载热点已开启，Wi-Fi Direct 无法同时启动</string>
    <string name="chosen_iphone_not_paired">在 DiPlay 中选择的 iPhone 已不再与车机配对</string>
    <string name="connection_help_chosen_iphone_not_paired">请重新将 iPhone 与车机蓝牙配对，或返回 DiPlay，点击“选择 iPhone”改选其他 iPhone。然后重试。</string>
    <string name="connection_help_choose_iphone">车机已与多台设备配对。请返回 DiPlay，点击“选择 iPhone”并选择你的 iPhone，然后重试。</string>
    <string name="wifi_direct_channel_unavailable">Wi-Fi Direct 无法使用首选信道</string>
    <string name="connection_help_wifi_direct_channel">请在“连接设置”中将“首选 Wi-Fi Direct 信道”设为“自动”，然后重试。</string>
    <string name="car_sees_no_usb_device">车机尚未检测到任何 USB 设备</string>
    <string name="car_sees_usb_device_not_iphone">车机检测到 USB 设备，但不是 iPhone</string>
    <string name="connection_help_no_usb_device">请使用 USB 数据线（有些线只能充电），插入车机的 USB 数据接口或 CarPlay 接口，并解锁 iPhone。</string>
    <string name="connection_help_usb_device_not_iphone">请用 USB 数据线连接车机的 USB 数据接口或 CarPlay 接口，拔掉其他 USB 设备，并解锁 iPhone。</string>
    <string name="car_hotspot_details_differ">车机热点设置与 DiPlay 中保存的不同</string>
    <string name="connection_help_car_hotspot_details_differ">请在“连接设置”中点击“编辑已保存的热点”，从车机热点设置中复制名称和密码，然后重试。</string>
    <string name="hotspot_interface_not_found">DiPlay 中保存的热点网络接口在此车机上不存在</string>
    <string name="connection_help_hotspot_interface_not_found">请在“连接设置”中点击“编辑已保存的热点”，清空“热点网络接口（可选）”，然后重试。</string>
    <string name="connection_help_car_hotspot_off">请在车机设置中开启车机热点，然后重试。</string>
    <string name="last_connection_attempt">上次连接尝试（%1$s）：%2$s</string>
    <string name="connection_help_hotspot">请确认车机热点已开启，且名称和密码与 DiPlay 设置一致。若支持，使用 5 GHz 后重试。</string>
    <string name="connection_help_iphone_wifi">保持 Wi-Fi 和蓝牙开启。在 iPhone 上连接车机热点并启用自动加入，然后重试。若仍失败，请保存诊断报告。</string>
    <string name="connection_help_permissions">请在车机上允许 DiPlay 所需的 USB、附近设备或位置信息权限，然后重试。</string>
    <string name="connection_help_usb">使用支持数据传输的 USB 接口和线缆。解锁 iPhone，允许信任和 CarPlay 提示，然后重试。</string>
    <string name="connection_help_bluetooth">解锁 iPhone，开启蓝牙和 Wi-Fi，并与车机配对。保持 iPhone 在附近后重试。</string>
    <string name="connection_help_general">请重试连接。如仍失败，请返回 DiPlay，在“设置 → 诊断”中保存报告。</string>
    <string name="connection_help_wifi_direct">保持车机的 Wi-Fi 和蓝牙开启，iPhone 解锁并放在附近，然后重试。如果仍然失败，请在 iPhone 的“设置 → 通用 → CarPlay 车载”中忘记这辆车，再重新连接。</string>
    <string name="connection_help_existing_wifi">请确认车机和 iPhone 连接的是同一个 Wi-Fi 网络，且网络名称和密码与 DiPlay 设置一致，然后重试。</string>
    <string name="settings_report_on_phone">在手机上取得报告</string>
    <string name="settings_report_on_phone_hint">用手机相机扫码，在浏览器中打开此页面，然后选择“下载报告”。下载完成前请保持此画面开启。</string>
    <string name="settings_mfi_target_description">只有车机上插着 CH341 认证适配器时才选择 USB/CH341。没有适配器时请选择「本地离线」。下次连接时生效。</string>
    <string name="settings_call_speakerphone">通话使用扬声器</string>
    <string name="settings_call_speakerphone_description">适用于用作车机的 Android 手机或平板：CarPlay 通话从扬声器播放而不是听筒，并使用免提麦克风。车机上请保持关闭。从下一次通话开始生效。</string>
    <string name="settings_navigation_attenuation">导航播报音量</string>
    <string name="settings_navigation_attenuation_value">%1$d dB</string>
    <string name="settings_navigation_attenuation_description">仅降低 CarPlay 导航播报音量，不影响音乐和通话。调整立即生效，车机自身的导航音量仍可使用。</string>
    <string name="settings_car_hotspot_control">车辆热点</string>
    <string name="settings_auto_car_hotspot_system_description">打开 DiPlay 时及无线连接前开启已保存的车辆热点。DiPlay 需要 Android 的“修改系统设置”权限；无需 ADB。若要在完全重启后也有热点，请同时开启“车辆启动后打开 DiPlay”。热点不会自动关闭。</string>
    <string name="settings_write_settings_granted">“修改系统设置”权限：已允许</string>
    <string name="settings_write_settings_missing">尚未允许“修改系统设置”权限。请允许，以便 DiPlay 开启热点。</string>
    <string name="settings_write_settings_allow">允许权限</string>
    <string name="settings_wifi_direct_scan_pause">CarPlay 期间暂停车机 Wi-Fi 搜索 · 需要 ADB</string>
    <string name="settings_wifi_direct_scan_pause_description">Wi-Fi 直连时，车机每隔几秒搜索一次 Wi-Fi 网络，每次搜索都会让音乐和画面卡顿。开启后，CarPlay 运行期间 DiPlay 会暂停这个搜索。这段时间车机也不会自动连接已知网络（例如手机热点），可以在车机 Wi-Fi 设置里手动连接；CarPlay 结束后恢复。关闭后车机可以自动连接。下次连接时生效。</string>
    <string name="temporary_system_bars">临时显示系统栏（5 秒）</string>
    <string name="temporary_system_bars_description">开启后，使用与 DiPlay 设置手势相同数量的手指向上滑动，暂时显示车机状态栏和导航栏 5 秒；向下滑动仍打开 DiPlay 设置。如果与车机手势冲突，请关闭此功能。部分设备可能无法显示。</string>
    <string name="wheel_media_play_pause">方向盘播放／暂停按钮</string>
    <string name="wheel_media_play_pause_description">将空闲的方向盘或键盘按键映射为 CarPlay 音乐播放／暂停。CarPlay 连接时可用；后台运行需要启用方向盘按键服务。通话或断开连接时保留车辆原有功能。车机可能拦截部分按键。</string>
    <string name="wheel_key_role_media_play_pause">播放／暂停</string>
    <string name="wheel_media_navigation_reserved">遥控器的导航、主页、音量、语音助手及现有媒体按键保留原有功能。请选择其他空闲按键。</string>
    <string name="black_corner_overlay">黑色圆角遮罩</string>
    <string name="black_corner_overlay_description">将 CarPlay 画面四角遮成黑色。可选择关闭、手动圆角半径或 iPhone 遮罩（实验性）。iPhone 模式需要重新连接；若未收到有效遮罩，则使用 24 dp 近似值。手动调整可立即预览，保存后保留设置。</string>
    <string name="black_corner_overlay_off">关闭</string>
    <string name="black_corner_overlay_value">%1$d dp</string>
    <string name="iphone_corner_mask_mode">iPhone 遮罩（实验性）</string>
    <string name="settings_launcher_bubble">桌面悬浮球（实验性）</string>
    <string name="settings_launcher_bubble_description">在车机桌面显示一个 DiPlay 悬浮球：点它直接回到 CarPlay，可拖动位置；打开 DiPlay 时自动隐藏，离开后重新出现。长按锁定位置，再次长按解锁。需要“显示在其他应用上层”权限。</string>
    <string name="settings_launcher_bubble_size">悬浮球大小</string>
    <string name="settings_launcher_bubble_locked">位置已锁定</string>
    <string name="settings_launcher_bubble_unlocked">位置已解锁</string>
    <string name="settings_launcher_bubble_hold_to_lock">长按 锁定</string>
    <string name="settings_launcher_bubble_hold_to_unlock">长按 解锁</string>

    <string name="settings_hotspot_interface">热点网络接口（可选）</string>
    <string name="settings_hotspot_interface_description">仅用于把热点放在 Android 不认为是 Wi-Fi 热点的网络接口上的车机，例如部分吉利、领克及其它高通车机上的 eth0.3。留空则自动查找。</string>
    <string name="settings_existing_wifi_interface">网络接口（可选）</string>
    <string name="settings_existing_wifi_interface_description">仅用于把同一局域网连接放在 Android 不认为是 Wi-Fi 的网络接口上的车机，例如 USB 网卡上的 eth1。留空则自动选择。</string>
    <string name="cluster_projection_shape">仪表盘地图形态</string>
    <string name="cluster_projection_shape_half">半屏（小屏导航）</string>
    <string name="cluster_projection_shape_full">全屏（全屏导航）</string>
    <string name="cluster_projection_shape_description">半屏会在仪表盘地图旁保留仪表原本的车速与状态信息；全屏则让地图占满整个仪表盘。CarPlay 地图出现时 DiPlay 会设置该形态，否则会覆盖你在车机上选好的导航模式。需要车机已授权网络 ADB。</string>
    <string name="settings_cluster_speedometer_album_color">速度表背景使用专辑颜色</string>
    <string name="settings_cluster_speedometer_album_color_description">平滑过渡到专辑边框的颜色，并保留所选的不透明度。</string>
</resources>

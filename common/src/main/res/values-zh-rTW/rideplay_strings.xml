<resources>
    <string name="settings_control_only_media_session">無音訊媒體控制（實驗性）</string>
    <string name="settings_control_only_media_session_description">不接收本機音訊、不要求音訊焦點，仍發佈媒體工作階段。須開啟透過車輛藍牙播放 CarPlay 音訊。下次連線生效，藍牙儀表相容性須實機驗證。</string>
    <string name="settings_orientation_lock">螢幕方向</string>
    <string name="settings_orientation_auto">自動</string>
    <string name="settings_orientation_landscape">橫向</string>
    <string name="settings_orientation_portrait">直向</string>
    <string name="settings_orientation_lock_description">鎖定首頁、設定與 CarPlay 畫面的方向。CarPlay 連線中更改此設定，會在確認後重新連線。自動模式恢復原有旋轉行為。</string>
    <string name="settings_pinyin_metadata">歌曲資訊拼音（實驗性）</string>
    <string name="settings_pinyin_metadata_description">離線轉換中文歌名與歌手。Android 媒體卡片也會顯示拼音，CarPlay 保留原文。多音字與人名可能讀錯。下次連線生效。</string>
    <string name="settings_pinyin_album">專輯名拼音</string>
    <string name="settings_pinyin_album_description">啟用歌曲資訊拼音後，同時轉換專輯名。下次連線生效。</string>
    <string name="settings_artist_rules">歌手名稱替換</string>
    <string name="settings_artist_rules_description">須先開啟歌曲資訊拼音。填寫 iPhone 顯示的完整原歌手名，自訂顯示名優先於自動拼音。顯示名留空可刪除規則。下次連線生效。</string>
    <string name="settings_artist_add">新增歌手</string>
    <string name="settings_artist_original">原歌手名稱</string>
    <string name="settings_artist_replacement">顯示名稱（留空刪除）</string>
    <string name="settings_artist_invalid">請填寫有效名稱：每項最多 200 字元，最多 100 條規則。</string>
</resources>
